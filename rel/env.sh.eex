#!/bin/sh

# epmd (Erlang's port finder, which `bin/hoodride rpc` / `remote` ask where the
# node is) on 127.0.0.1 only — by default it listens on every address. The
# node's own port: vm.args.eex.
export ERL_EPMD_ADDRESS=127.0.0.1

# ...and the node named by that address: the default short name uses the
# machine's hostname, which needn't resolve to 127.0.0.1 (in WSL it didn't —
# `rpc` failed with :noconnection). Set RELEASE_NODE to run a second copy.
export RELEASE_DISTRIBUTION=name
: "${RELEASE_NODE:=<%= @release.name %>@127.0.0.1}"
export RELEASE_NODE
