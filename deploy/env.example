# /etc/hoodride/env — the app's settings and secrets (setup.sh creates it from
# this file, owned root:hoodride, mode 0640). Never commit the real one.

# the public hostname (Cloudflare)
PHX_HOST=hood.example.com

# signs cookies and tokens: `openssl rand -base64 48` (setup.sh fills it in)
SECRET_KEY_BASE=CHANGE_ME

# the password for `bin/hoodride rpc` / `remote` (setup.sh fills it in);
# deploy.sh deletes the release's own COOKIE file, which anyone could read
RELEASE_COOKIE=CHANGE_ME

# listen on this Unix socket (cloudflared: service unix:/run/hoodride/app.sock);
# also trusts connections over it as the proxy (HoodrideWeb.ClientIp)
SOCKET_PATH=/run/hoodride/app.sock

# Google sign-in (GOOGLE_SETUP.md §1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook sign-in (GOOGLE_SETUP.md, Facebook) — its button appears once set
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---- Optional: leave these out unless you need them ----

# Instead of SOCKET_PATH, listen on a normal port, e.g. behind your own
# proxy (SELF_HOSTING.md, "If the socket link misbehaves"):
# BIND_IP=127.0.0.1
# PORT=4000
# the proxy's address(es), comma-separated: only they may say who the
# visitor is (X-Forwarded-For), which the rate limits rely on
# TRUSTED_PROXIES=127.0.0.1

# database connections (SQLite: accounts only); 5 is plenty
# POOL_SIZE=5

# the languages switched on, comma-separated (unset: English only). Each
# visitor gets the one they pick, else their browser's, else English.
# Only languages the app has translations for (priv/gettext/)
# LANGUAGES=en

# map updates are gathered for this many milliseconds and sent as one
# message (default 500; 0 = send each one at once)
# MAP_BATCH_MS=500

# for load testing only: 0 re-encodes every map update per viewer
# MAP_ENCODE_ONCE=1

# leave unset: Hood Ride runs on exactly one server (SELF_HOSTING.md)
# DNS_CLUSTER_QUERY=
